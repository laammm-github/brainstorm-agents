# LLM 配置
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_STRONG=Qwen/Qwen2.5-7B-Instruct
LLM_MODEL_FAST=Qwen/Qwen2.5-7B-Instruct
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Agent 配置
MAX_DEBATE_ROUNDS=2
AGENT_TEMPERATURE=0.8
COORDINATOR_TEMPERATURE=0.5

# RAG 配置（个人知识库）
CHUNK_SIZE=500
CHUNK_OVERLAP=50
VECTOR_STORE_PATH=./data/vector_store
KNOWLEDGE_BASE_PATH=./knowledge_base

# API 配置
API_HOST=0.0.0.0
API_PORT=8001
API_DEBUG=true

# 成本控制
ENABLE_COST_CONTROL=true
MAX_TOKENS_PER_SESSION=50000
